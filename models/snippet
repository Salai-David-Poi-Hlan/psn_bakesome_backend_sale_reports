# -*- coding: utf-8 -*-
from odoo import api, models
import pytz
from datetime import datetime, time


class SaleReport(models.Model):
    _inherit = "sale.report"

    @api.model
    def get_utc_date_bounds(self, date_from, date_to):
        """Convert local calendar-day boundaries (YYYY-MM-DD strings) into
        UTC datetime strings, using the company's timezone rather than the
        browser's local clock, so "today" always means the store's today.

        :param date_from: str 'YYYY-MM-DD'
        :param date_to: str 'YYYY-MM-DD'
        :return: dict with 'date_from' (>=) and 'date_to' (<, exclusive)
                 as 'YYYY-MM-DD HH:MM:SS' UTC strings
        """
        company = self.env.company
        tz_name = company.partner_id.tz or 'UTC'
        try:
            local_tz = pytz.timezone(tz_name)
        except pytz.UnknownTimeZoneError:
            local_tz = pytz.UTC

        start_naive = datetime.combine(
            datetime.strptime(date_from, '%Y-%m-%d').date(), time.min
        )
        # exclusive upper bound = local midnight of the day AFTER date_to
        end_date = datetime.strptime(date_to, '%Y-%m-%d').date()
        end_naive = datetime.combine(end_date, time.min)
        from datetime import timedelta
        end_naive += timedelta(days=1)

        start_utc = local_tz.localize(start_naive).astimezone(pytz.UTC)
        end_utc = local_tz.localize(end_naive).astimezone(pytz.UTC)

        return {
            'date_from': start_utc.strftime('%Y-%m-%d %H:%M:%S'),
            'date_to': end_utc.strftime('%Y-%m-%d %H:%M:%S'),
        }


# -*- coding: utf-8 -*-
from odoo import api, models
from datetime import datetime, time, timedelta, timezone
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError


class SaleReport(models.Model):
    _inherit = "sale.report"

    @api.model
    def get_utc_date_bounds(self, date_from, date_to):
        """Convert local calendar-day boundaries (YYYY-MM-DD strings) into
        UTC datetime strings, using the company's timezone rather than the
        browser's local clock, so "today" always means the store's today.

        :param date_from: str 'YYYY-MM-DD'
        :param date_to: str 'YYYY-MM-DD'
        :return: dict with 'date_from' (>=) and 'date_to' (<, exclusive)
                 as 'YYYY-MM-DD HH:MM:SS' UTC strings
        """
        company = self.env.company
        tz_name = company.partner_id.tz or 'UTC'
        try:
            local_tz = ZoneInfo(tz_name)
        except ZoneInfoNotFoundError:
            local_tz = ZoneInfo('UTC')

        start_naive = datetime.combine(
            datetime.strptime(date_from, '%Y-%m-%d').date(), time.min
        )
        end_naive = datetime.combine(
            datetime.strptime(date_to, '%Y-%m-%d').date(), time.min
        ) + timedelta(days=1)

        start_utc = start_naive.replace(tzinfo=local_tz).astimezone(timezone.utc)
        end_utc = end_naive.replace(tzinfo=local_tz).astimezone(timezone.utc)

        return {
            'date_from': start_utc.strftime('%Y-%m-%d %H:%M:%S'),
            'date_to': end_utc.strftime('%Y-%m-%d %H:%M:%S'),
        }