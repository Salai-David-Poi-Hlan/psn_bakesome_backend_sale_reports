<?xml version="1.0" encoding="UTF-8"?>
<templates>

    <t t-name="psn_bakesome_backend_sale_reports.TopProducts" owl="1">
<div class="o_sale_channel_dashboard p-3 d-flex flex-column" style="height: calc(100vh - 60px);">
     <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
      <div style="margin-left:60px">
                   <img src="/psn_bakesome_backend_sale_reports/static/src/image/bakesome.jpg" style="width:50px;height:50px;border-radius:9999px"/>
                </div>

                               <h2 class="me-auto mb-0 text-white">Top 20 Products</h2>
                 <div>
                   <label class="form-label mb-0">Branch</label>
                   <select class="form-select form-select-sm" t-on-change="onBranchChange">
                       <option value="">All Branches</option>
                         <t t-foreach="filters.branches" t-as="branch" t-key="branch.id">
                            <option t-att-value="branch.id" t-esc="branch.name"/>
                         </t>
                   </select>
                 </div>

                 <div>
                    <label class="form-label mb-0">Channel</label>
                    <select class="form-select form-select-sm" t-on-change="onChannelChange">
                <option  value="">All Channels</option>
             <option  value="backend">Backend</option>
                <option  value="website">Website</option>
                <option  value="pos">POS</option>
                <option  value="line_oa">Line OA</option>
                <option  value="shopee">Shopee</option>

                    </select>
                 </div>

                     <div>
               <label class="form-label mb-0">From</label>
               <input type="date" class="form-control form-control-sm"
                    t-model="filters.dateFrom" t-on-change="onDateChange"
               />
            </div>
            <div>
                  <label class="form-label mb-0">To</label>
                  <input type="date" class="form-control form-control-sm"
                     t-model="filters.dateTo" t-on-change="onDateChange"
                  />
            </div>

            <div>
                    <label class="form-label mb-0">Rank By</label>
                    <select class="form-select form-select-sm" t-on-change="onSortByChange">
                             <option value="price_subtotal">Revenue</option>
                              <option value="product_uom_qty">Quantity</option>

                    </select>
            </div>
            </div>



        <div class="row g-3 mb-3">
                    <div class="col-md-8">
                       <div class="card shadow-sm h-100">
    <div class="card-body">
        <div class="d-flex align-items-center mb-2">
            <button class="btn btn-sm btn-outline-secondary" t-on-click="toggleChartPage">
                <t t-esc="chartPageLabel"/>
            </button>
        </div>
        <div style="height:320px">
            <canvas t-ref="barCanvas"/>
        </div>
    </div>
</div>
                    </div>

            <div class="col-md-4">
    <div class="card shadow-sm h-100">
        <div class="card-body d-flex flex-column">
            <h6 class="text-muted mb-3">Summary (Top 20)</h6>

            <div class="d-flex align-items-center gap-3 py-3 border-bottom">
                <div class="rounded-circle bg-warning bg-opacity-25 d-flex align-items-center justify-content-center"
                     style="width:44px;height:44px;">
                    <i class="fa fa-cubes text-warning"/>
                </div>
                <div>
                    <div class="text-muted small">Total Quantity</div>
                    <div class="fs-4 fw-bold" t-esc="formatMoney(state.summary.totalQty)"/>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3 py-3 border-bottom">
                <div class="rounded-circle bg-success bg-opacity-25 d-flex align-items-center justify-content-center"
                     style="width:44px;height:44px;">
                    <i class="fa fa-money text-success"/>
                </div>
                <div>
                    <div class="text-muted small">Total Revenue (excl. VAT)</div>
                    <div class="fs-4 fw-bold" t-esc="formatMoney(state.summary.totalRevenue)"/>
                </div>
            </div>


            <div class="mt-auto pt-2 text-muted small text-end">
                Based on top 20 products in selected range
            </div>
        </div>
    </div>
</div>
        </div>


  <div class="card shadow-sm flex-grow-1 d-flex flex-column" style="min-height: 0;">
        <div class="card-body d-flex flex-column" style="min-height: 0;">
            <div class="flex-grow-1" style="min-height: 0; overflow-y: auto;">
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;">No</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;">Image</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;">Product Name</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Quantity</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Revenue (excl. VAT)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.topProducts" t-as="p" t-key="p.id">
                            <td t-esc="p_index + 1"/>
                            <td>
                                <img t-att-src="p.imageUrl" style="width:40px;height:40px;object-fit:cover;border-radius:4px;"/>
                            </td>
                            <td t-esc="p.name"/>
                            <td class="text-end" t-esc="formatMoney(p.qty)"/>
                            <td class="text-end" t-esc="formatMoney(p.revenue)"/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
          </div>
    </t>

