<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="psn_bakesome_backend_sale_reports.SalePurchaseReport">
         <div class="o_sale_channel_dashboard p-3 d-flex flex-column">
                 <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                    <div style="margin-left:60px">
                             <img src="/psn_bakesome_backend_sale_reports/static/src/image/bakesome.jpg" style="width:50px;height:50px;border-radius:9999px"/>
                </div>
                <h2 class="me-auto mb-0 text-white">Sale Purchase Analytic Dashboard</h2>
                <div>
                    <label class="form-label mb-0">Branch</label>
                    <select class="form-select form-select-sm"  t-on-change="onBranchChange">
                            <option value="">All Branches</option>
                            <t t-foreach="filters.branches" t-as="branch" t-key="branch.id">
                                  <option t-att-value="branch.id" t-esc="branch.name"/>
                            </t>
                    </select>
                </div>
                  <div>
                       <label class="form-label mb-0">From</label>
                       <input class="form-control form-control-sm" type="date" t-model="filters.dateFrom" t-on-change="onDateChange"/>
                  </div>
                  <div>
                       <label class="form-label mb-0">To</label>
                       <input class="form-control form-control-sm" type="date" t-model="filters.dateTo" t-on-change="onDateChange"/>
                  </div>
                  <div>
                       <label class="form-label mb-0">Rank By</label>
                       <select class="form-select form-select-sm" t-on-change="onSortByChange">
                               <option value="price_total">Revenue</option>
                               <option value="qty">Quantity</option>
                       </select>
                  </div>
                 </div>


        <div class="row g-3 mb-4">
                 <div class="col-md-3">
                          <div class="card shadow-sm h-100">
                             <div class="card-body">
                            <div class="text-muted small">Gross Purchases</div>
                              <div class="fs-4 fw-bold" t-esc="formatMoney(state.summary.totalRevenue)"/>
                             </div>
                          </div>
                 </div>

                 <div class="col-md-3">
                      <div class="card shadow-sm h-100">
                           <div class="card-body">
                               <div class="text-muted small">Net Purchases</div>
                               <div class="fs-4 fw-bold" t-esc="formatMoney(state.summary.totalNet)"/>
                           </div>
                      </div>
                 </div>

                  <div class="col-md-3">
                      <div class="card shadow-sm h-100">
                           <div class="card-body">
                               <div class="text-muted small">Untaxed Purchased Amount</div>
                               <div class="fs-4 fw-bold" t-esc="formatMoney(state.summary.totalUntaxed)"/>
                           </div>
                      </div>
                 </div>


                <div class="col-md-3">
                      <div class="card shadow-sm h-100">
                           <div class="card-body">
                               <div class="text-muted small">Average Purchased Amount</div>
                               <div class="fs-4 fw-bold" t-esc="formatMoney(state.summary.totalAverage)"/>
                           </div>
                      </div>
                 </div>


                <div class="col-md-3">
                      <div class="card shadow-sm h-100">
                           <div class="card-body">
                               <div class="text-muted small">Total Purchased Discount Amount</div>
                               <div class="fs-4 fw-bold" t-esc="formatMoney(state.summary.totalDiscount)"/>
                           </div>
                      </div>
                 </div>



                <div class="col-md-3">
                      <div class="card shadow-sm h-100">
                           <div class="card-body">
                               <div class="text-muted small">Total Quantity </div>
                               <div class="fs-4 fw-bold" t-esc="formatMoney(state.summary.totalQty)"/>
                           </div>
                      </div>
                 </div>

                 <div class="col-md-3">
                      <div class="card shadow-sm h-100">
                           <div class="card-body">
                               <div class="text-muted small">Total Purchase Orders </div>
                               <div class="fs-4 fw-bold" t-esc="formatMoney(state.summary.purchaseOrders)"/>
                           </div>
                      </div>
                 </div>


                  <div class="col-md-3">
                      <div class="card shadow-sm h-100">
                           <div class="card-body">
                              <table>
                                   <tr>
                                        <td>
                                             Gross Sale
                                        </td>
                                        <td>
                                            <div class="fs-4 fw-bold" t-esc="formatMoney(state.summary.totalSaleRevenue)"/>
                                        </td>
                                   </tr>
                                   <tr>
                                        <td>
                                            Gross Profit
                                        </td>
                                        <td>
                                               <t t-if="state.summary.totalSaleRevenue>state.summary.totalRevenue">
                                                  <div class="fs-4 fw-bold text-success"  t-esc="formatMoney(state.summary.totalSaleRevenue-state.summary.totalRevenue)"/>
                                               </t>
                                              <t t-elif="state.summary.totalRevenue>state.summary.totalSaleRevenue">
                                                  <div class="fs-4 fw-bold text-danger"  t-esc="formatMoney(state.summary.totalSaleRevenue-state.summary.totalRevenue)"/>
                                               </t>
                                               <t t-else="">
                                                      <div class="fs-4 fw-bold"  t-esc="0.0"/>
                                               </t>
                                        </td>
                                   </tr>
                              </table>
                           </div>
                      </div>
                 </div>
        </div>

            <h5 style="color:white;margin:10px 0px">Top-20 Purchasing Products</h5>
     <div class="card shadow-sm flex-grow-1 d-flex flex-column" style="min-height: 0;">
        <div class="card-body d-flex flex-column" style="min-height: 0;">
            <div class="flex-grow-1" style="min-height: 0; overflow-y: auto;">
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;">No</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;">Image</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;">Product Name</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Quantity</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Purchase Price</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Discount Amount</th>
                        <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Purchase Orders</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.topProducts" t-as="p" t-key="p.id">
                            <td t-esc="p_index + 1"/>
                            <td>
                                <img t-att-src="p.imageUrl" style="width:40px;height:40px;object-fit:cover;border-radius:4px;"/>
                            </td>
                            <td t-esc="p.name"/>
                            <td class="text-end" t-esc="formatMoney(p.qty)"/>
                            <td class="text-end" t-esc="formatMoney(p.revenue)"/>
                            <td class="text-end" t-esc="formatMoney(p.discount)"/>
                            <td class="text-end" t-esc="formatMoney(p.orders)"/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

            <h5 style="color:white;margin:10px 0px;">Top-20 Suppliers</h5>
     <div class="card shadow-sm flex-grow-1 d-flex flex-column" style="min-height: 0;">
        <div class="card-body d-flex flex-column" style="min-height: 0;">
            <div class="flex-grow-1" style="min-height: 0; overflow-y: auto;">
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;">No</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;">Supplier Name</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Quantity</th>
                             <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Untaxed Price</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Purchase Price</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Net Purchase Price</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Discount Amount</th>
                        <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Purchase Orders</th>
                        <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Average Order Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.topVendors" t-as="v" t-key="v.id">
                            <td t-esc="v_index + 1"/>
                            <td t-esc="v.name"/>
                            <td class="text-end" t-esc="formatMoney(v.totalQty)"/>
                            <td class="text-end" t-esc="formatMoney(v.totalUntaxed)"/>
                            <td class="text-end" t-esc="formatMoney(v.totalRevenue)"/>
                            <td class="text-end" t-esc="formatMoney(v.totalNet)"/>
                            <td class="text-end" t-esc="formatMoney(v.totalDiscount)"/>
                            <td class="text-end" t-esc="formatMoney(v.total_orders)"/>
                            <td class="text-end" t-esc="formatMoney(v.totalAverage)"/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

       <div class="row g-3 mb-3">
         <div class="col-md-6">
                <div class="card shadow-sm h-200">
               <div class="card-body d-flex flex-column">

                <div class="d-flex align-items mb-2">
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="toggleChartPage"> 
                   <t t-esc="chartPageLabel"/>
                    </button>
                </div>
                          <div style='height:640px'>
                          <canvas t-ref="productsBarCanvas"/>
                          </div>
               </div>
                </div>
         </div>
           <div class="col-md-6">
<div class="card shadow-sm h-200">
               <div class="card-body d-flex flex-column">

                <div class="d-flex align-items mb-2">
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="toggleChartPageSale"> 
                   <t t-esc="chartPageLabelSale"/>
                    </button>
                </div>
                          <div style='height:640px'>
                          <canvas t-ref="productsBarCanvas_Sale"/>
                          </div>
               </div>
                </div>
         </div>

       </div>

         </div>
    </t>
</templates>