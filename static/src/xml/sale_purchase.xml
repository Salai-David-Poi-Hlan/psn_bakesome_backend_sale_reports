<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="psn_bakesome_backend_sale_reports.SalePurchaseReport">
         <div class="o_sale_channel_dashboard p-3 d-flex flex-column">
                 <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                    <div style="margin-left:60px">
                             <img src="/psn_bakesome_backend_sale_reports/static/src/image/bakesome.jpg" style="width:50px;height:50px;border-radius:9999px"/>
                </div>
                <h2 class="me-auto mb-0 text-white">Sale Purchase Analytic Dashboard</h2>
                <div>
                    <label class="form-label mb-0">Branch</label>
                    <select class="form-select form-select-sm"  t-on-change="onBranchChange">
                            <option value="">All Branches</option>
                            <t t-foreach="filters.branches" t-as="branch" t-key="branch.id">
                                  <option t-att-value="branch.id" t-esc="branch.name"/>
                            </t>
                    </select>
                </div>
                  <div>
                       <label class="form-label mb-0">From</label>
                       <input class="form-control form-control-sm" type="date" t-model="filters.dateFrom" t-on-change="onDateChange"/>
                  </div>
                  <div>
                       <label class="form-label mb-0">To</label>
                       <input class="form-control form-control-sm" type="date" t-model="filters.dateTo" t-on-change="onDateChange"/>
                  </div>
                  <div>
                       <label class="form-label mb-0">Rank By</label>
                       <select class="form-select form-select-sm" t-on-change="onSortByChange">
                               <option value="price_total">Revenue</option>
                               <option value="qty">Quantity</option>
                       </select>
                  </div>
                 </div>


        <div class="row g-3 mb-4">
                 <div class="col-md-3">
                          <div class="card shadow-sm h-100">
                             <div class="card-body">
                            <div class="text-muted small">Gross Purchases</div>
                              <div class="fs-4 fw-bold" t-esc="formatMoney(state.summary.totalGross)"/>
                               <div class="text-muted small">ก่อนหักส่วนลด (ไม่รวม VAT)</div>
                             </div>
                          </div>
                 </div>

                 <div class="col-md-3">
                      <div class="card shadow-sm h-100">
                           <div class="card-body">
                               <div class="text-muted small">Net Purchases</div>
                               <div class="fs-4 fw-bold" t-esc="formatMoney(state.summary.totalNet)"/>
                               <div class="text-muted small">หลังหักส่วนลด (ไม่รวม VAT)</div>
                           </div>
                      </div>
                 </div>

                  <div class="col-md-3">
                      <div class="card shadow-sm h-100">
                           <div class="card-body">
                               <div class="text-muted small">Net Purchases incl. VAT</div>
                               <div class="fs-4 fw-bold" t-esc="formatMoney(state.summary.totalRevenue)"/>
                               <div class="text-muted small">หลังหักส่วนลด (รวม VAT)</div>
                           </div>
                      </div>
                 </div>


                <div class="col-md-3">
                      <div class="card shadow-sm h-100">
                           <div class="card-body">
                               <div class="text-muted small">Avg per Purchase Order</div>
                               <div class="fs-4 fw-bold" t-esc="formatMoney(state.summary.totalAverage)"/>
                               <div class="text-muted small">Net Purchases / # PO</div>
                           </div>
                      </div>
                 </div>


                <div class="col-md-3">
                      <div class="card shadow-sm h-100">
                           <div class="card-body">
                               <div class="text-muted small">Total Purchased Discount Amount</div>
                               <div class="fs-4 fw-bold" t-esc="formatMoney(state.summary.totalDiscount)"/>
                               <div class="text-muted small">ไม่รวม VAT</div>
                           </div>
                      </div>
                 </div>



                <div class="col-md-3">
                      <div class="card shadow-sm h-100">
                           <div class="card-body">
                               <div class="text-muted small">Total Quantity </div>
                               <div class="fs-4 fw-bold" t-esc="formatMoney(state.summary.totalQty)"/>
                           </div>
                      </div>
                 </div>

                 <div class="col-md-3">
                      <div class="card shadow-sm h-100">
                           <div class="card-body">
                               <div class="text-muted small">Total Purchase Orders </div>
                               <div class="fs-4 fw-bold" t-esc="state.summary.purchaseOrders"/>
                           </div>
                      </div>
                 </div>


                  <div class="col-md-3">
                      <div class="card shadow-sm h-100">
                           <div class="card-body">
                              <table>
                                   <tr>
                                        <td>
                                             Net Sales (untaxed)
                                        </td>
                                        <td>
                                            <div class="fs-4 fw-bold" t-esc="formatMoney(state.summary.totalSaleRevenue)"/>
                                        </td>
                                   </tr>
                                   <tr>
                                        <td>
                                            Sales − Purchases<div class="text-muted small">ไม่ใช่กำไร (ไม่ได้หักต้นทุนขาย)</div>
                                        </td>
                                        <td>
                                               <t t-if="state.summary.totalSaleRevenue>state.summary.totalNet">
                                                  <div class="fs-4 fw-bold text-success"  t-esc="formatMoney(state.summary.totalSaleRevenue-state.summary.totalNet)"/>
                                               </t>
                                              <t t-elif="state.summary.totalNet>state.summary.totalSaleRevenue">
                                                  <div class="fs-4 fw-bold text-danger"  t-esc="formatMoney(state.summary.totalSaleRevenue-state.summary.totalNet)"/>
                                               </t>
                                               <t t-else="">
                                                      <div class="fs-4 fw-bold"  t-esc="0.0"/>
                                               </t>
                                        </td>
                                   </tr>
                              </table>
                           </div>
                      </div>
                 </div>
        </div>

            <h5 style="color:white;margin:10px 0px">Top-20 Purchasing Products</h5>
     <div class="card shadow-sm flex-grow-1 d-flex flex-column" style="min-height: 0;">
        <div class="card-body d-flex flex-column" style="min-height: 0;">
            <div class="flex-grow-1" style="min-height: 0; overflow-y: auto;">
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;">No</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;">Image</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;">Product Name</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Quantity</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Purchase Amount (incl. VAT)</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Discount (untaxed)</th>
                        <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Purchase Orders</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.topProducts" t-as="p" t-key="p.id">
                            <td t-esc="p_index + 1"/>
                            <td>
                                <img t-att-src="p.imageUrl" style="width:40px;height:40px;object-fit:cover;border-radius:4px;"/>
                            </td>
                            <td t-esc="p.name"/>
                            <td class="text-end" t-esc="formatMoney(p.qty)"/>
                            <td class="text-end" t-esc="formatMoney(p.revenue)"/>
                            <td class="text-end" t-esc="formatMoney(p.discount)"/>
                            <td class="text-end" t-esc="formatMoney(p.orders)"/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

            <h5 style="color:white;margin:10px 0px;">Top-20 Suppliers</h5>
     <div class="card shadow-sm flex-grow-1 d-flex flex-column" style="min-height: 0;">
        <div class="card-body d-flex flex-column" style="min-height: 0;">
            <div class="flex-grow-1" style="min-height: 0; overflow-y: auto;">
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;">No</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;">Supplier Name</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Quantity</th>
                             <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Gross (before discount)</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Discount</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Net (untaxed)</th>
                            <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Net incl. VAT</th>
                        <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Purchase Orders</th>
                        <th style="position: sticky; top: 0; background: white; z-index: 1;" class="text-end">Avg per PO (untaxed)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.topVendors" t-as="v" t-key="v.id">
                            <td t-esc="v_index + 1"/>
                            <td t-esc="v.name"/>
                            <td class="text-end" t-esc="formatMoney(v.totalQty)"/>
                            <td class="text-end" t-esc="formatMoney(v.totalGross)"/>
                            <td class="text-end" t-esc="formatMoney(v.totalDiscount)"/>
                            <td class="text-end" t-esc="formatMoney(v.totalNet)"/>
                            <td class="text-end" t-esc="formatMoney(v.totalRevenue)"/>
                            <td class="text-end" t-esc="v.total_orders"/>
                            <td class="text-end" t-esc="formatMoney(v.totalAverage)"/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

        <div class="row g-3 mb-3 mt-3">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title mb-0 me-auto text-center">Top 20 Purchased Products</h5>
                <div class="d-flex align-items mb-2">
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="toggleChartPage">
                        <t t-esc="chartPageLabel"/>
                    </button>
                </div>
                <div style="height:640px">
                    <canvas t-ref="productsBarCanvas"/>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title mb-3">Purchase vs Sale Summary</h5>
                <div class="d-grid gap-3" style="height:640px; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr;">

                    <div class="d-flex flex-column justify-content-center align-items-center rounded p-3"
                         style="background:#fff4e6; border-left:4px solid orange;">
                        <div class="text-muted small text-uppercase">Purchase Revenue</div>
                        <div class="fs-2 fw-bold" t-esc="formatMoney(state.topSummaryOnPurchase.totalPurchaseRevenue)"/>
                    </div>

                    <div class="d-flex flex-column justify-content-center align-items-center rounded p-3"
                         style="background:#fff4e6; border-left:4px solid orange;">
                        <div class="text-muted small text-uppercase">Purchase Quantity</div>
                        <div class="fs-2 fw-bold" t-esc="formatMoney(state.topSummaryOnPurchase.totalPurchaseQty)"/>
                    </div>

                    <div class="d-flex flex-column justify-content-center align-items-center rounded p-3"
                         style="background:#e6f7f5; border-left:4px solid teal;">
                        <div class="text-muted small text-uppercase">Sale Revenue</div>
                        <div class="fs-2 fw-bold" t-esc="formatMoney(state.topSummaryOnPurchase.totalSaleRevenue)"/>
                    </div>

                    <div class="d-flex flex-column justify-content-center align-items-center rounded p-3"
                         style="background:#e6f7f5; border-left:4px solid teal;">
                        <div class="text-muted small text-uppercase">Sale Quantity</div>
                        <div class="fs-2 fw-bold" t-esc="formatMoney(state.topSummaryOnPurchase.totalSaleQty)"/>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

         <div class="row g-3 mb-3">
   
     <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title mb-3">Sale vs Purchase Summary</h5>
                <div class="d-grid gap-3" style="height:640px; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr;">

                    <div class="d-flex flex-column justify-content-center align-items-center rounded p-3"
                         style="background:#fff4e6; border-left:4px solid orange;">
                        <div class="text-muted small text-uppercase">Total Sale Revenue</div>
                        <div class="fs-2 fw-bold" t-esc="formatMoney(state.topSummaryOnSale.totalSaleRevenue)"/>
                    </div>

                    <div class="d-flex flex-column justify-content-center align-items-center rounded p-3"
                         style="background:#fff4e6; border-left:4px solid orange;">
                        <div class="text-muted small text-uppercase">Total Sale Quantity</div>
                        <div class="fs-2 fw-bold" t-esc="formatMoney(state.topSummaryOnSale.totalSaleQty)"/>
                    </div>

                    <div class="d-flex flex-column justify-content-center align-items-center rounded p-3"
                         style="background:#e6f7f5; border-left:4px solid teal;">
                        <div class="text-muted small text-uppercase">Total Purchase Revenue</div>
                        <div class="fs-2 fw-bold" t-esc="formatMoney(state.topSummaryOnSale.totalPurchaseRevenue)"/>
                    </div>

                    <div class="d-flex flex-column justify-content-center align-items-center rounded p-3"
                         style="background:#e6f7f5; border-left:4px solid teal;">
                        <div class="text-muted small text-uppercase">Total Purchase Quantity</div>
                        <div class="fs-2 fw-bold" t-esc="formatMoney(state.topSummaryOnSale.totalPurchaseQty)"/>
                    </div>

                </div>
            </div>
        </div>
    </div>

     <div class="col-md-6">
        <div class="card shadow-sm" style="min-height: 500px;">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title mb-0 me-auto text-center">Top 20 Sale Products</h5>

                <div class="d-flex align-items mb-2">
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="toggleChartPageSale">
                        <t t-esc="chartPageLabelSale"/>
                    </button>
                </div>
                <div style="height:640px">
                    <canvas t-ref="productsBarCanvas_Sale"/>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title mb-0 me-auto text-center">Top Suppliers</h5>
                <div class="d-flex align-items mb-2">
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="toggleChartPageVendor">
                        <t t-esc="chartPageVendor"/>
                    </button>
                </div>
                <div style="width:100%; height:640px">
                    <canvas t-ref="vendorCanvas"/>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="row g-3 mb-3">
    <div class="col-md-6">
          <div class="card shadow-sm h-100">
             <div class="card-body d-flex flex-column">
                 <div style="height:500px">
                 <canvas t-ref="branchCanvas"/>
                 </div>
             </div>
          </div>
    </div>
</div>

         </div>
    </t>
</templates>