<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sale_channel_dashboard.TopProducts" owl="1">
        <div class="o_sale_channel_dashboard p-3">
            <div class="d-flex align-items-end gap-3 mb-3 flex-wrap">
                <h2 class="me-auto mb-0">Top 20 Products</h2>
                <div>
                    <label class="form-label mb-0">Branch</label>
                    <select class="form-select form-select-sm" t-on-change="onBranchChange">
                        <option value="">All Branches</option>
                        <t t-foreach="state.branches" t-as="branch" t-key="branch.id">
                            <option t-att-value="branch.id" t-esc="branch.name"/>
                        </t>
                    </select>
                </div>
                <div>
                    <label class="form-label mb-0">Channel</label>
                    <select class="form-select form-select-sm" t-on-change="onChannelChange">
                        <option value="">All Channels</option>
                        <option value="backend">Backend Sale</option>
                        <option value="website">Website</option>
                        <option value="pos">POS</option>
                        <option value="line_oa">Line OA</option>
                    </select>
                </div>
                <div>
                    <label class="form-label mb-0">From</label>
                    <input type="date" class="form-control form-control-sm"
                        t-model="state.dateFrom" t-on-change="onFilterChange"/>
                </div>
                <div>
                    <label class="form-label mb-0">To</label>
                    <input type="date" class="form-control form-control-sm"
                        t-model="state.dateTo" t-on-change="onFilterChange"/>
                </div>
                <div>
                    <label class="form-label mb-0">Rank By</label>
                    <select class="form-select form-select-sm" t-on-change="onSortByChange">
                        <option value="price_subtotal">Revenue</option>
                        <option value="product_uom_qty">Quantity</option>
                    </select>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Product</th>
                                <th class="text-end">Backend</th>
                                <th class="text-end">Website</th>
                                <th class="text-end">POS</th>
                                <th class="text-end">Line OA</th>
                                <th class="text-end fw-bold">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.topProducts" t-as="p" t-key="p.id">
                                <td t-esc="p_index + 1"/>
                                <td t-esc="p.name"/>
                                <td class="text-end" t-esc="formatMoney(p.byChannel.backend)"/>
                                <td class="text-end" t-esc="formatMoney(p.byChannel.website)"/>
                                <td class="text-end" t-esc="formatMoney(p.byChannel.pos)"/>
                                <td class="text-end" t-esc="formatMoney(p.byChannel.line_oa)"/>
                                <td class="text-end fw-bold" t-esc="formatMoney(p.total)"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>

